# /etc/default/signot-mesh-bridge -- not in git.
# The Pi's OWN Meshtastic radio (not the one paired to the phone): ls -l /dev/serial/by-id/
MESH_PORT=
# Fleet alerts go only on this secondary channel (never the primary/public one).
MESH_CHANNEL=signot
# Node ids to show as device trackers in Home Assistant, e.g. the phone's Heltec
MESH_MY_NODES=
MESH_KISMET_MIN_SEV=7
MESH_RATE_SEC=60
MESH_BURST=3
MESH_DEDUPE_MIN=30
# 1 = log alerts instead of transmitting
MESH_DRY_RUN=1
MESH_NODE=ragnarpwn
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
