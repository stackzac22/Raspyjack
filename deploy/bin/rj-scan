#!/usr/bin/env bash
# rj-scan — toggle jack's Wi-Fi capture stack on/off.
#
# The rtw88 (8821cu) USB adapter can hard-lock the kernel while Kismet is
# channel-hopping it. When you use jack for non-Wi-Fi work, `rj-scan off` stops
# Kismet and idles the dongle so the crash-prone path isn't running. `rj-scan on`
# brings it back. Only touches wlan1 — the built-in wlan0 uplink is untouched.
set -e
case "${1:-status}" in
  off)
    echo "[rj-scan] stopping capture stack..."
    systemctl stop raspyjack-kismet-watchdog kismet 2>/dev/null || true
    iw dev wlan1mon del 2>/dev/null || true
    ip link set wlan1 down 2>/dev/null || true
    echo "[rj-scan] OFF — kismet + watchdog stopped, wlan1 down (dongle idle)"
    ;;
  on)
    echo "[rj-scan] starting capture stack..."
    ip link set wlan1 up 2>/dev/null || true
    systemctl start kismet raspyjack-kismet-watchdog
    echo "[rj-scan] ON — kismet + watchdog started"
    ;;
  status)
    echo "kismet:            $(systemctl is-active kismet 2>/dev/null)"
    echo "kismet-watchdog:   $(systemctl is-active raspyjack-kismet-watchdog 2>/dev/null)"
    echo "presence:          $(systemctl is-active raspyjack-presence 2>/dev/null)"
    echo "interfaces:"
    iw dev 2>/dev/null | grep -E "Interface|type" | sed 's/^/  /'
    ;;
  *)
    echo "usage: rj-scan {on|off|status}"; exit 1 ;;
esac
