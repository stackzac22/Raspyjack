# /etc/default/squachwatch-bridge  -- not in git, holds the broker login.
# Find the port with: ls -l /dev/serial/by-id/
SQW_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
# 2000000 for cyd* builds, 921600 for most other boards (see platformio.ini)
SQW_BAUD=2000000
SQW_NODE=raspyjackboy
SQW_POLL=5
SQW_ALERT_MIN=10
# The fleet's MQTT broker (one authoritative place -- see signot ARCHITECTURE.md)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
#MQTT_USER=
#MQTT_PASS=
