RPi/*
# OPi port: shadow package so `import RPi.GPIO` resolves to the libgpiod shim
!RPi/__init__.py
!RPi/GPIO.py
__pycache__/

# --- device-specific / personal config (protect your info) ---
gui_conf.json
*.bak
*.tmp
*.swp

# --- secrets & keys (never commit) ---
*.pem
*.key
id_rsa*
*.env
.env
discord_webhook_local.txt

# device-generated secrets / tokens (WebUI, Wigle, Tailscale, etc.)
.webui_token
.webui_auth.json
.webui_session_secret
.wigle_credentials.json
.tailscale_auth_key
*_credentials.json
*.authkey

# --- captured loot / live-engagement data (keep shipped samples, ignore new captures) ---
loot/payload.log
loot/**/*.pcap
loot/**/*.pcapng
loot/**/*.cap
loot/**/*.hccapx
loot/**/*.hash
loot/**/*.john
loot/**/*.potfile
loot/**/*.xml
loot/Responder/
loot/SquachWatch/
loot/Handshakes/
loot/Credentials/
loot/Screenshots/

# --- stored wifi credentials ---
wifi/configs/
*.wpa_supplicant.conf

# --- frame mirrors / runtime scratch ---
*.frame
loot/SquachWatch/

# --- nested repos with their own git history (Ragnar is updated by
#     update_ragnar.sh + /usr/local/share/ragnar-local-patches, not by us) ---
vendor/ragnar/
vendor/RagnarScripts/

# --- machine-local secrets, state and backups: never commit ---
.wdgwars_key
.webui_auth.json.*
config/ai_report.json*
config/ssid_pool/
wifi/profiles/
wifi/*.log
models/
*.bak-*
*.bak.*

# --- run output (already-tracked loot templates stay tracked) ---
loot/*
